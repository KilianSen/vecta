# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
# Every variable referenced in gateway.json must be set (empty is allowed only
# where the config gives a default), or the gateway refuses to start.

# Public hostname players connect to (wildcard DNS *.domain -> NPM host).
ANYMCP_DOMAIN=play.example.com
# HMAC key for route cookies. Keep it stable across restarts.
ANYMCP_COOKIE_SECRET=
# Bearer token for GET /metrics.
ANYMCP_METRICS_TOKEN=
# Token for the "admin" owner in gateway.json (agents and plugins use it).
ANYMCP_OWNER_TOKEN=
# Optional first MOTD line.
# ANYMCP_MOTD=Example network

# Published host ports (remove the ports in compose.yaml when joining NPM's network).
MC_PORT=25565
API_PORT=8080

# Run a prebuilt image instead of building from this repository.
# ANYMCP_IMAGE=registry.example.com/anymcp:1.0.0
# ANYMCP_VERSION=1.0.0
